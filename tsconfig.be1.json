{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types/latest"]
  },
  "include": [
    "next-env.d.ts",
    "worker-configuration.d.ts",
    "app/_backend/be1/**/*.ts",
    "app/api/be1/route.ts",
    "app/_prototype/businessState.ts",
    "app/business/_components/useBusinessContext.ts",
    "app/business/_components/BusinessContextSwitcher.tsx",
    "app/business/settings/**/*.tsx",
    "db/**/*.ts",
    "worker/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "tests/be1.test.ts"
  ],
  "exclude": ["node_modules"]
}
