{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meawketting",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meawketting-production",
      "migrations_dir": "migrations/d1",
      "database_id": "3e920509-817c-4d36-9243-7ad0afe4a874"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meawketting-private-media"
    }
  ]
}