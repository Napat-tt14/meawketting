{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meawketting-pilot-REPLACE",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": ["/api/*", "/business/*", "/"] },
  "vars": {
    "MEAWKETTING_ENV": "staging",
    "MEAWKETTING_AUTH_MODE": "google",
    "MEAWKETTING_FIXTURE_MODE": "off",
    "MEAWKETTING_PUBLIC_ORIGIN": "https://meawketting.com",
    "MEAWKETTING_GOOGLE_OWNER_EMAIL": "ane049116049@gmail.com",
    "MEAWKETTING_GOOGLE_OWNER_PERSON_ID": "prs_01k47meawketting000000001"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_SEPARATE_STAGING_DB", "database_id": "REPLACE_DATABASE_ID", "migrations_dir": "drizzle" }],
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 } }
}
