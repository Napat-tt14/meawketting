{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types/latest"]
  },
  "include": [
    "next-env.d.ts",
    "worker-configuration.d.ts",
    "app/_backend/be1/**/*.ts",
    "app/_backend/be2/**/*.ts",
    "app/_backend/be3/**/*.ts",
    "app/api/be1/route.ts",
    "app/api/be2/route.ts",
    "app/api/be3/route.ts",
    "db/**/*.ts",
    "worker/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "tests/be3.test.ts"
  ],
  "exclude": ["node_modules", "workfiledesign"]
}
