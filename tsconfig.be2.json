{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types/latest"]
  },
  "include": [
    "next-env.d.ts",
    "worker-configuration.d.ts",
    "app/_backend/be1/**/*.ts",
    "app/_backend/be2/**/*.ts",
    "app/api/be1/route.ts",
    "app/api/be2/route.ts",
    "app/_prototype/businessState.ts",
    "app/_prototype/be2PassportCompatibility.ts",
    "app/business/_components/BusinessPortalFrame.tsx",
    "app/business/_components/useBusinessContext.ts",
    "app/business/customers/**/*.tsx",
    "app/business/customers/**/*.ts",
    "app/business/calendar/BookingEditor.tsx",
    "db/**/*.ts",
    "worker/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "tests/be2.test.ts"
  ],
  "exclude": ["node_modules", "workfiledesign"]
}
