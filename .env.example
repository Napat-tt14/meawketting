DATABASE_MIGRATION_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEAWKETTING_AUTH_MODE=supabase
MEAWKETTING_PUBLIC_ORIGIN=
MEAWKETTING_ENV=staging
MEAWKETTING_FIXTURE_MODE=off
