{
  "name": "meawketting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:production": "tsx --test tests/production.test.ts",
    "typecheck:production": "tsc -p tsconfig.production.json --pretty false",
    "test:api:smoke": "node --import tsx scripts/production-api-smoke.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:frontend && npm run test:backend && npm run test:production && npm run test:api:smoke",
    "lint": "eslint app worker tests scripts db vite.config.ts drizzle.config.ts next.config.ts eslint.config.mjs",
    "typecheck:be1": "tsc -p tsconfig.be1.json --pretty false",
    "typecheck:be2": "tsc -p tsconfig.be2.json --pretty false",
    "typecheck:be3": "tsc -p tsconfig.be3.json --pretty false",
    "typecheck:be4": "tsc -p tsconfig.be4.json --pretty false",
    "typecheck:be5": "tsc -p tsconfig.be5.json --pretty false",
    "typecheck:be6": "tsc -p tsconfig.be6.json --pretty false",
    "typecheck:be7": "tsc -p tsconfig.be7.json --pretty false",
    "typecheck:be8": "tsc -p tsconfig.be8.json --pretty false",
    "test:frontend": "node --test tests/rendered-html.test.mjs && tsx --test tests/business-loading.test.ts tests/business-refresh.test.ts",
    "test:backend": "tsx --test tests/be1.test.ts tests/be2.test.ts tests/be2-cache.test.ts tests/be3.test.ts tests/be4.test.ts tests/be5.test.ts tests/be6.test.ts tests/be7.test.ts tests/be8.test.ts tests/runtime.test.ts tests/auth.test.ts tests/auth-platform.test.mjs tests/migrations.test.ts tests/registration.test.ts tests/p2-optimization.test.ts tests/d1-races.test.ts tests/d1-performance.test.ts tests/d1-transfer.test.mjs tests/d1-platform.test.ts",
    "db:migrate": "wrangler d1 migrations apply DB --config wrangler.d1.json --local",
    "db:seed:test": "node scripts/d1-seed.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "tsx --test tests/migrations.test.ts",
    "test:be1": "tsx --test tests/be1.test.ts",
    "test:be2": "tsx --test tests/be2.test.ts",
    "test:be3": "tsx --test tests/be3.test.ts",
    "test:be4": "tsx --test tests/be4.test.ts",
    "test:be5": "tsx --test tests/be5.test.ts",
    "test:be6": "tsx --test tests/be6.test.ts",
    "test:be7": "tsx --test tests/be7.test.ts",
    "test:be8": "tsx --test tests/be8.test.ts"
  },
  "dependencies": {
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.0.16",
    "wrangler": "4.92.0",
    "postgres": "^3.4.9",
    "drizzle-orm": "^0.45.2",
    "miniflare": "4.20260515.0"
  },
  "type": "module"
}
