{
  "name": "meawketting",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:be1 && npm run test:be2 && npm run test:be3",
    "test:be1": "tsx --test tests/be1.test.ts",
    "test:be2": "tsx --test tests/be2.test.ts tests/be2-cache.test.ts",
    "test:be3": "node scripts/run-be3-tests.mjs",
    "lint": "eslint app worker tests scripts db vite.config.ts drizzle.config.ts next.config.ts eslint.config.mjs",
    "typecheck:be1": "tsc -p tsconfig.be1.json --pretty false",
    "typecheck:be2": "tsc -p tsconfig.be2.json --pretty false",
    "typecheck:be3": "tsc -p tsconfig.be3.json --pretty false",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "npm run db:check:be1 && npm run db:check:be2 && npm run db:check:be3",
    "db:check:be1": "node scripts/check-be1-migrations.mjs",
    "db:check:be2": "node scripts/check-be2-migrations.mjs",
    "db:check:be3": "node scripts/check-be3-migrations.mjs",
    "db:local:migrate": "wrangler d1 migrations apply DB --local --config wrangler.be1.jsonc",
    "db:local:seed": "npm run db:local:seed:be1 && npm run db:local:seed:be2 && npm run db:local:seed:be3",
    "db:local:seed:be1": "wrangler d1 execute DB --local --config wrangler.be1.jsonc --file scripts/seed-be1-dev.sql",
    "db:local:seed:be2": "wrangler d1 execute DB --local --config wrangler.be1.jsonc --file scripts/seed-be2-dev.sql",
    "db:local:seed:be3": "node scripts/seed-be3-local.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
